    <LangVersion>latest</LangVersion>
    <Description>Orion QUANT-36: emits the alpha_artifact 1.0 contract from a finished LEAN backtest</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Common\QuantConnect.csproj" />
  </ItemGroup>
</Project>
